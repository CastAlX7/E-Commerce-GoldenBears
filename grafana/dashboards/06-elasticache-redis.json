{
  "title": "06 - ElastiCache Redis",
  "uid": "gb-redis",
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "custom",
        "query": "dev,qa,prod",
        "current": { "text": "dev", "value": "dev" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CurrConnections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "CloudWatch",
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ElastiCache",
          "metricName": "CurrConnections",
          "statistic": "Average",
          "dimensions": { "ReplicationGroupId": "e-comerce-golden-bears-redis-$workspace" },
          "region": "us-east-1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Evictions",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "CloudWatch",
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ElastiCache",
          "metricName": "Evictions",
          "statistic": "Sum",
          "dimensions": { "ReplicationGroupId": "e-comerce-golden-bears-redis-$workspace" },
          "region": "us-east-1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache Hit Rate (%) — calculado con Metric Math (hits / (hits+misses))",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "CloudWatch",
      "targets": [
        {
          "refId": "hits",
          "namespace": "AWS/ElastiCache",
          "metricName": "CacheHits",
          "statistic": "Sum",
          "dimensions": { "ReplicationGroupId": "e-comerce-golden-bears-redis-$workspace" },
          "region": "us-east-1",
          "id": "hits",
          "hidden": true
        },
        {
          "refId": "misses",
          "namespace": "AWS/ElastiCache",
          "metricName": "CacheMisses",
          "statistic": "Sum",
          "dimensions": { "ReplicationGroupId": "e-comerce-golden-bears-redis-$workspace" },
          "region": "us-east-1",
          "id": "misses",
          "hidden": true
        },
        {
          "refId": "hit_rate",
          "expression": "hits / (hits + misses) * 100",
          "region": "us-east-1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ReplicationLag",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "CloudWatch",
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ElastiCache",
          "metricName": "ReplicationLag",
          "statistic": "Average",
          "dimensions": { "ReplicationGroupId": "e-comerce-golden-bears-redis-$workspace" },
          "region": "us-east-1"
        }
      ]
    }
  ]
}
