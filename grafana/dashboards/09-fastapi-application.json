{
  "title": "09 - FastAPI Application (Prometheus)",
  "uid": "gb-fastapi",
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latencia por endpoint — p50 / p95 / p99",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "golden-bears-prometheus"
      },
      "targets": [
        {
          "refId": "p50",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p50 {{handler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "golden-bears-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p95 {{handler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "golden-bears-prometheus"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "p99",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p99 {{handler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "golden-bears-prometheus"
          },
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tasa de requests por endpoint (req/s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "golden-bears-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m])) by (handler)",
          "legendFormat": "{{handler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "golden-bears-prometheus"
          },
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tasa de error 5xx por endpoint (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "golden-bears-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (handler) / sum(rate(http_requests_total[5m])) by (handler)",
          "legendFormat": "{{handler}}",
          "datasource": {
            "type": "prometheus",
            "uid": "golden-bears-prometheus"
          },
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
