{
  "title": "03 - RDS Proxy — Connection Pool",
  "uid": "gb-rds-proxy",
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "custom",
        "query": "dev,qa,prod",
        "current": { "text": "dev", "value": "dev" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Conexiones en transacción / en cola",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": "CloudWatch",
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/RDS",
          "metricName": "DatabaseConnectionsCurrentlyInTransaction",
          "statistic": "Average",
          "dimensions": { "ProxyName": "e-comerce-golden-bears-proxy-$workspace" },
          "region": "us-east-1"
        },
        {
          "refId": "B",
          "namespace": "AWS/RDS",
          "metricName": "ConnectionRequestsQueued",
          "statistic": "Average",
          "dimensions": { "ProxyName": "e-comerce-golden-bears-proxy-$workspace" },
          "region": "us-east-1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Conexiones disponibles",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": "CloudWatch",
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/RDS",
          "metricName": "DatabaseConnectionsAvailable",
          "statistic": "Average",
          "dimensions": {
            "ProxyName": "e-comerce-golden-bears-proxy-$workspace",
            "TargetGroup": "default"
          },
          "region": "us-east-1"
        }
      ]
    }
  ]
}
