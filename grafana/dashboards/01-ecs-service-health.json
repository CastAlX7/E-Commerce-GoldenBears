{
  "title": "01 - ECS Service Health",
  "uid": "gb-ecs-health",
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "custom",
        "query": "dev,qa,prod",
        "current": {
          "text": "dev",
          "value": "dev"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RunningTaskCount vs DesiredTaskCount",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "golden-bears-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "ECS/ContainerInsights",
          "metricName": "RunningTaskCount",
          "statistic": "Average",
          "dimensions": {
            "ClusterName": "e-comerce-golden-bears-ecs-cluster-$workspace",
            "ServiceName": "e-comerce-golden-bears-svc-$workspace"
          },
          "region": "us-east-1",
          "datasource": {
            "type": "cloudwatch",
            "uid": "golden-bears-cloudwatch"
          },
          "queryMode": "Metrics",
          "id": "",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0
        },
        {
          "refId": "B",
          "namespace": "ECS/ContainerInsights",
          "metricName": "DesiredTaskCount",
          "statistic": "Average",
          "dimensions": {
            "ClusterName": "e-comerce-golden-bears-ecs-cluster-$workspace",
            "ServiceName": "e-comerce-golden-bears-svc-$workspace"
          },
          "region": "us-east-1",
          "datasource": {
            "type": "cloudwatch",
            "uid": "golden-bears-cloudwatch"
          },
          "queryMode": "Metrics",
          "id": "",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU / Memory Utilization (%)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "golden-bears-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "ECS/ContainerInsights",
          "metricName": "CpuUtilized",
          "statistic": "Average",
          "dimensions": {
            "ClusterName": "e-comerce-golden-bears-ecs-cluster-$workspace",
            "ServiceName": "e-comerce-golden-bears-svc-$workspace"
          },
          "region": "us-east-1",
          "datasource": {
            "type": "cloudwatch",
            "uid": "golden-bears-cloudwatch"
          },
          "queryMode": "Metrics",
          "id": "",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0
        },
        {
          "refId": "B",
          "namespace": "ECS/ContainerInsights",
          "metricName": "MemoryUtilized",
          "statistic": "Average",
          "dimensions": {
            "ClusterName": "e-comerce-golden-bears-ecs-cluster-$workspace",
            "ServiceName": "e-comerce-golden-bears-svc-$workspace"
          },
          "region": "us-east-1",
          "datasource": {
            "type": "cloudwatch",
            "uid": "golden-bears-cloudwatch"
          },
          "queryMode": "Metrics",
          "id": "",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Errores recientes del backend (logs Insights)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "golden-bears-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": [
            "/ecs/e-comerce-golden-bears-$workspace"
          ],
          "region": "us-east-1",
          "expression": "fields @timestamp, @message | filter @message like /(?i)(error|exception|traceback)/ | sort @timestamp desc | limit 100",
          "datasource": {
            "type": "cloudwatch",
            "uid": "golden-bears-cloudwatch"
          },
          "id": ""
        }
      ]
    }
  ]
}
