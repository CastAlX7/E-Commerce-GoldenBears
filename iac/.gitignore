# Terraform state
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Plan files
*.tfplan
*.plan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda artifacts (placeholders y zips reales)
*.zip

# Variables con secretos reales (nunca commitear)
*.auto.tfvars
secrets.tfvars

# Archivos de variables por entorno (se crean al levantar el entorno, no se versionan)
*.tfvars
